{
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
//#if (UseAuth)
  "Authentication": {
    "Authority": "",
    "Audience": "api",
    "RequireHttpsMetadata": true
  },
//#endif
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WritePermitLimit": 30,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "Wolverine": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
