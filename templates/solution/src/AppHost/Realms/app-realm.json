{
  "realm": "app",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clientScopes": [
    {
      "name": "api",
      "description": "Access to the API",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "app-dev",
      "name": "Development client (password + client credentials grants)",
      "enabled": true,
      "publicClient": false,
      "secret": "app-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [ "http://localhost:*", "https://localhost:*" ],
      "webOrigins": [ "+" ],
      "defaultClientScopes": [ "api", "profile", "email", "basic" ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "alice", "temporary": false } ]
    }
  ]
}
